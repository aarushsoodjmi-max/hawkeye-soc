# HawkEye SOC local/demo configuration
# Copy to .env. Never commit a real .env file.

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_DEMO_MODE=true

# Backend
ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://hawkeye:change-me-local-only@localhost:5432/hawkeye
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
AUTH_REQUIRED=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_USERS_JSON=

# Optional Gemini provider; leave empty for the deterministic offline demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional local inference service; deterministic demo does not need it.
HAWKEYE_AI_SERVER_URL=http://localhost:8080
